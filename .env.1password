# 1Password secret references for the publish step.
#
# These are *references*, not secrets — safe to commit. `op run` resolves them
# at launch and injects the values into the child process environment only:
# nothing is written to disk, nothing lands in shell history, and rotating the
# item in 1Password needs no change here.
#
#     op run --env-file=.env.1password -- ./scripts/upload.sh
#
# Adjust the vault and item names to match your own 1Password setup. Find the
# exact reference for a field with:
#
#     op item get "Cloudflare R2" --format json | jq '.fields[] | {label, reference}'

CLOUDFLARE_ACCOUNT_ID="op://Private/CloudFlare R2 - Snowdesk/R2/Account ID"

# setup-bucket.sh only. Wrangler cannot run its interactive OAuth flow from a
# script, so it needs a token. This is the "Token value" on the R2 API token
# item — a different credential from the S3 key pair below, same item.
CLOUDFLARE_API_TOKEN="op://Private/CloudFlare R2 - Snowdesk/R2 API - Account Token/Token value"
AWS_ACCESS_KEY_ID="op://Private/CloudFlare R2 - Snowdesk/R2 API - Account Token/S3 Access Key ID"
AWS_SECRET_ACCESS_KEY="op://Private/CloudFlare R2 - Snowdesk/R2 API - Account Token/S3 Secret Access Key"

# Only needed for the second setup-bucket.sh pass, once the zone is live.
CLOUDFLARE_ZONE_ID="op://Private/CloudFlare R2 - Snowdesk/R2 API - Account Token/zone id"
